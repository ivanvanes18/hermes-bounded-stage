{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "additionalProperties": false,
      "properties": {
        "complexity": {
          "additionalProperties": false,
          "properties": {
            "choice": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "confidence": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "probabilities": {
              "additionalProperties": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "maxProperties": 64,
              "minProperties": 1,
              "type": "object"
            },
            "type": {
              "const": "choice"
            }
          },
          "required": [
            "type",
            "choice",
            "confidence",
            "probabilities"
          ],
          "type": "object"
        },
        "context_sufficiency": {
          "additionalProperties": false,
          "properties": {
            "noul": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "type": {
              "const": "noul"
            }
          },
          "required": [
            "type",
            "noul"
          ],
          "type": "object"
        },
        "risk": {
          "additionalProperties": false,
          "properties": {
            "noul": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "type": {
              "const": "noul"
            }
          },
          "required": [
            "type",
            "noul"
          ],
          "type": "object"
        },
        "route": {
          "additionalProperties": false,
          "properties": {
            "choice": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "confidence": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "probabilities": {
              "additionalProperties": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "maxProperties": 64,
              "minProperties": 1,
              "type": "object"
            },
            "type": {
              "const": "choice"
            }
          },
          "required": [
            "type",
            "choice",
            "confidence",
            "probabilities"
          ],
          "type": "object"
        },
        "verifiability": {
          "additionalProperties": false,
          "properties": {
            "noul": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "type": {
              "const": "noul"
            }
          },
          "required": [
            "type",
            "noul"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "checks_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "confidence": {
      "additionalProperties": false,
      "properties": {
        "margin": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "route": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "route",
        "margin"
      ],
      "type": "object"
    },
    "eligible_routes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "hard_overrides": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "methodology_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "parent_acceptance": {
      "const": false
    },
    "permissions_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_version": {
      "const": "executor-policy-1"
    },
    "provider_model": {
      "enum": [
        null,
        "jev-1.13.0"
      ]
    },
    "readiness": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "adapter_digest": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "effort": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_kind": {
            "enum": [
              "synthetic",
              "live",
              "deterministic"
            ]
          },
          "expires_at": {
            "minimum": 0,
            "type": "number"
          },
          "harness": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ready": {
            "type": "boolean"
          },
          "reason": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "registry_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "route_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "stage_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "supported_modes": {
            "items": {
              "enum": [
                "read_only",
                "bounded_write"
              ]
            },
            "maxItems": 2,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "ready",
          "route_hash",
          "registry_hash",
          "stage_hash",
          "evidence_kind",
          "harness",
          "model",
          "effort",
          "supported_modes",
          "adapter_digest",
          "reason",
          "expires_at"
        ],
        "type": "object"
      },
      "maxProperties": 32,
      "type": "object"
    },
    "reason": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "registry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "selected_route": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "selected_route_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "policy",
        "fixed",
        "jev"
      ]
    },
    "stage_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "maximum": 1000000000,
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "maximum": 1000000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "policy_version",
    "stage_hash",
    "methodology_hash",
    "registry_hash",
    "selected_route",
    "selected_route_hash",
    "eligible_routes",
    "readiness",
    "answers",
    "confidence",
    "hard_overrides",
    "reason",
    "source",
    "usage",
    "provider_model",
    "permissions_hash",
    "checks_hash",
    "parent_acceptance"
  ],
  "type": "object"
}
