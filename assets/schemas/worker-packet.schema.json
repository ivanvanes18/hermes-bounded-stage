{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_paths": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "controller_checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected_exit": {
            "maximum": 0,
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "pins_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "expected_exit",
          "pins_hash"
        ],
        "type": "object"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "domain_rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "skill": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "text": {
            "maxLength": 1600,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "skill",
          "rule_id",
          "text",
          "source_sha256"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "executor_route": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "forbidden": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "methodology_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mode": {
      "enum": [
        "read_only",
        "bounded_write"
      ]
    },
    "nonce": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "objective": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "output_contract": {
      "additionalProperties": false,
      "properties": {
        "allow_delete": {
          "const": false
        },
        "max_changed_files": {
          "maximum": 64,
          "minimum": 0,
          "type": "integer"
        },
        "required_paths": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "required_paths",
        "allow_delete",
        "max_changed_files"
      ],
      "type": "object"
    },
    "route_receipt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_proof_requirements": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "selected_context": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "text": {
            "maxLength": 64000,
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_sha256",
          "text"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "stage_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "stage_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "stop_conditions": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "workflow": {
      "additionalProperties": false,
      "properties": {
        "domain_skills": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "version": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "version",
              "sha256"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "process_owner": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "stage": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "name",
            "version",
            "sha256",
            "stage"
          ],
          "type": "object"
        }
      },
      "required": [
        "domain_skills",
        "process_owner"
      ],
      "type": "object"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "baseline_tree_hash",
        "current_input_hashes",
        "previous_evidence_hash",
        "correction_evidence"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "baseline_tree_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_input_hashes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "previous_evidence_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "correction_evidence": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "passed",
              "reason"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "maxLength": 128
              },
              "passed": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "stage_id",
    "stage_hash",
    "methodology_hash",
    "route_receipt_hash",
    "nonce",
    "workflow",
    "objective",
    "inputs",
    "allowed_paths",
    "forbidden",
    "domain_rules",
    "output_contract",
    "controller_checks",
    "stop_conditions",
    "mode",
    "runtime_proof_requirements",
    "executor_route",
    "selected_context",
    "execution"
  ],
  "type": "object"
}
