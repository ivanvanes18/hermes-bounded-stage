{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/loop-receipt.schema.json",
  "title": "One loop-level selection, checkpoint or redirect receipt",
  "description": "Create-only evidence of what the controller offered and what was decided. parent_acceptance is always false: final acceptance stays parent-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","kind","loop_hash","loop_state_hash","transition_hash","iteration",
               "allowed","decision","source","reason","answers","confidence","evidence_hash",
               "carried_tree_hash","usage","provider_model","parent_acceptance"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"enum": ["selection","checkpoint","redirect"]},
    "loop_hash": {"$ref": "#/$defs/sha256"},
    "loop_state_hash": {"$ref": "#/$defs/sha256"},
    "transition_hash": {"$ref": "#/$defs/sha256"},
    "iteration": {"type": "integer", "minimum": 0, "maximum": 4},
    "allowed": {"type": "array", "minItems": 1, "maxItems": 16,
                "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "decision": {"type": "string", "minLength": 1, "maxLength": 128},
    "source": {"enum": ["parent","jev","policy"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 128},
    "answers": {"type": "object", "maxProperties": 64},
    "confidence": {
      "type": "object", "additionalProperties": false,
      "required": ["choice","margin"],
      "properties": {"choice": {"type": "number", "minimum": 0, "maximum": 1},
                     "margin": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "evidence_hash": {"$ref": "#/$defs/sha256_or_null"},
    "carried_tree_hash": {"$ref": "#/$defs/sha256_or_null"},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens","output_tokens"],
      "properties": {"input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
                     "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000}}
    },
    "provider_model": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
    "parent_acceptance": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256_or_null": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}
  }
}
